{
  "name": "marp-preview",
  "version": "1.2.1",
  "description": "A simple desktop app to preview Marp markdown files in real-time.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "test": "jest --coverage",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "marp",
    "markdown",
    "preview"
  ],
  "author": {
    "name": "Masanori Kado",
    "email": "kdmsnr@gmail.com",
    "url": "https://kdmsnr.com"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@citation-js/core": "^0.7.21",
    "@citation-js/plugin-bibtex": "^0.7.21",
    "@citation-js/plugin-csl": "^0.7.22",
    "@marp-team/marp-cli": "^4.4.0",
    "@marp-team/marp-core": "^4.3.0",
    "@marp-team/marpit": "^3.2.1",
    "chokidar": "^5.0.0",
    "js-yaml": "^5.2.1",
    "markdown-it-footnote": "^4.0.0",
    "marp-theme-science-tokyo": "https://github.com/kdmsnr/marp-theme_science-tokyo/archive/baccb3a1dd486526d5b3ae5c2c6065113874b960.tar.gz"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.3.0",
    "prettier": "^3.8.3"
  },
  "build": {
    "appId": "com.kdmsnr.marp-preview",
    "productName": "Marp Preview",
    "mac": {
      "target": "dmg",
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown"
          ],
          "name": "Markdown Document",
          "role": "Viewer",
          "rank": "Alternate"
        }
      ]
    },
    "win": {
      "target": "nsis"
    },
    "asarUnpack": [
      "node_modules/@marp-team/marp-cli/**",
      "node_modules/marp-theme-science-tokyo/**",
      "node_modules/puppeteer/**"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "app/**/*.js"
    ]
  }
}
